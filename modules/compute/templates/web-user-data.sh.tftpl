
#!/bin/bash
set -euxo pipefail

dnf install -y nginx openssl

mkdir -p /etc/nginx/ssl

openssl req -x509 -nodes -days 365 \
  -newkey rsa:2048 \
  -keyout /etc/nginx/ssl/terraform-lab.key \
  -out /etc/nginx/ssl/terraform-lab.crt \
  -subj "/CN=terraform-lab.local"

cat > /etc/nginx/conf.d/terraform-app.conf <<'NGINX'
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/terraform-lab.crt;
    ssl_certificate_key /etc/nginx/ssl/terraform-lab.key;

    location / {
        proxy_pass http://${app_private_ip}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
NGINX

systemctl enable nginx
systemctl restart nginx
