
#!/bin/bash
set -euo pipefail
umask 077

dnf install -y nginx openssl

mkdir -p /etc/nginx/ssl

openssl req -x509 -nodes -days 365 \
  -newkey rsa:2048 \
  -keyout /etc/nginx/ssl/terraform-lab.key \
  -out /etc/nginx/ssl/terraform-lab.crt \
  -subj "/CN=terraform-lab.local"

cat > /etc/nginx/conf.d/terraform-app.conf <<'NGINX'
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/terraform-lab.crt;
    ssl_certificate_key /etc/nginx/ssl/terraform-lab.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_tokens       off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        proxy_pass http://${app_private_ip}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
NGINX

chmod 0600 /etc/nginx/ssl/terraform-lab.key
chmod 0644 /etc/nginx/ssl/terraform-lab.crt

systemctl enable nginx
systemctl restart nginx
